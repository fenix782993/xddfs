import asyncio, logging, html, random
from aiogram import Bot, Dispatcher, F
from aiogram.filters import CommandStart, Command
from aiogram.types import Message, CallbackQuery
from app.config import settings
from app.db import (init_db,close_db,ensure_user,get_user,claim_daily_bonus,get_referrals,get_shop,buy_item,is_admin,admin_give,admin_take,set_ban,leaderboard,get_stats,create_pvp,get_open_pvp,join_pvp,finish_pvp)
from app.games import play,create_mines_board
from app.keyboards.main import main_menu,back_menu
from app.keyboards.games import games_menu,bet_menu

logging.basicConfig(level=logging.INFO)
log=logging.getLogger('fenix.bot')
bot=Bot(settings.bot_token)
dp=Dispatcher()

NAMES={'dice':'🎲 DICE','darts':'🎯 DARTS','football':'⚽ FOOTBALL','basketball':'🏀 BASKETBALL','bowling':'🎳 BOWLING','slots':'🎰 SLOTS','mines':'💣 MINES','crash':'📈 CRASH','roulette':'🎡 ROULETTE','coinflip':'🪙 COIN FLIP','blackjack':'🃏 BLACKJACK','reaction':'⚡ REACTION','race':'🏁 RACE'}

def fmt(n): return f'{int(n):,}'.replace(',',' ')

def render_result(code,r):
    win=int(r.get('win_amount',0)); bet=int(r.get('bet',0)); profit=win-bet; m=r.get('multiplier',0)
    if code=='slots': detail=' | '.join(r.get('symbols',[]))
    elif code=='crash': detail=f"Краш: {r.get('crash_at')}x · Cashout: {r.get('cashout')}x"
    elif code=='roulette': detail=f"Число: {r.get('number')} · {r.get('color')}"
    elif code=='mines': detail=f"Открыто: {len(r.get('opened',[]))} · Множитель: {m}x"
    elif code=='reaction': detail=f"Реакция: {r.get('milliseconds')} ms"
    elif code=='race': detail=f"Место: {r.get('place')} · Кубики: {r.get('rolls')}"
    elif code=='blackjack': detail=f"Игрок: {r.get('player_total')} · Дилер: {r.get('dealer_total')} · {r.get('outcome')}"
    else: detail=r.get('display') or f"Множитель: {m}x"
    return f"{NAMES.get(code,code)}\n\n{detail}\n\n{'🎉 ПОБЕДА' if profit>=0 and win>0 else '💀 ПРОИГРЫШ'}\n💰 Ставка: {fmt(bet)} FC\n📈 Выплата: {fmt(win)} FC\n📊 Итог: {'+' if profit>=0 else ''}{fmt(profit)} FC"

@dp.message(CommandStart())
async def start(message:Message):
    ref=None; parts=(message.text or '').split(maxsplit=1)
    if len(parts)>1 and parts[1].startswith('ref_'):
        try: ref=int(parts[1][4:])
        except: pass
    user,_=await ensure_user(message.from_user,ref)
    await message.answer(f"🔥 <b>FENIX COIN ULTRA</b>\n\n💰 Баланс: <b>{fmt(user['balance'])}</b> FC\n⭐ Уровень: <b>{user['level']}</b>\n🏆 Побед: <b>{user['wins']}</b>\n\nПолноценная игровая платформа: игры, PvP, бонусы, рефералы, магазин и админ-панель.",reply_markup=main_menu(settings.webapp_url),parse_mode='HTML')

@dp.callback_query(F.data=='home')
async def home(c:CallbackQuery):
    u=await get_user(c.from_user.id); await c.message.edit_text(f"🔥 <b>FENIX COIN ULTRA</b>\n\n💰 Баланс: <b>{fmt(u['balance'])}</b> FC\n⭐ Уровень: <b>{u['level']}</b>",reply_markup=main_menu(settings.webapp_url),parse_mode='HTML'); await c.answer()

@dp.callback_query(F.data=='profile')
async def profile(c:CallbackQuery):
    u=await get_user(c.from_user.id)
    if not u: await c.answer('Открой /start',show_alert=True); return
    await c.message.edit_text(f"👤 <b>ПРОФИЛЬ</b>\n\n🆔 <code>{u['id']}</code>\n👤 @{html.escape(u['username'] or 'нет')}\n💰 <b>{fmt(u['balance'])}</b> FC\n⭐ XP: <b>{fmt(u['xp'])}</b>\n🏅 Level: <b>{u['level']}</b>\n🎮 Игр: <b>{u['games']}</b>\n🏆 Побед: <b>{u['wins']}</b>\n💀 Поражений: <b>{u['losses']}</b>\n👥 Рефералов: <b>{u['referrals']}</b>",reply_markup=back_menu(),parse_mode='HTML'); await c.answer()

@dp.callback_query(F.data=='games')
async def games(c:CallbackQuery): await c.message.edit_text('🎮 <b>FENIX GAMES</b>\n\nВыбирай игру. Все результаты серверные и сохраняются в PostgreSQL.',reply_markup=games_menu(),parse_mode='HTML'); await c.answer()

@dp.callback_query(F.data.startswith('game:'))
async def game(c:CallbackQuery):
    code=c.data.split(':',1)[1]
    await c.message.edit_text(f"<b>{NAMES.get(code,code)}</b>\n\n💰 Выбери ставку.\n⚡ Результат рассчитывается сервером.\n💾 История записывается в БД.",reply_markup=bet_menu(code),parse_mode='HTML'); await c.answer()

@dp.callback_query(F.data.startswith('bet:'))
async def bet(c:CallbackQuery):
    _,code,amount=c.data.split(':'); amount=int(amount); uid=c.from_user.id
    try:
        r=await play(uid,code,amount)
        await c.message.edit_text(render_result(code,r),reply_markup=bet_menu(code),parse_mode='HTML')
        await c.answer('Готово 🔥')
    except Exception as e:
        await c.answer(str(e)[:180],show_alert=True)

@dp.callback_query(F.data=='bonus')
async def bonus(c:CallbackQuery):
    try:
        reward,streak=await claim_daily_bonus(c.from_user.id)
        await c.message.edit_text(f'🎁 <b>DAILY BONUS</b>\n\nПолучено: <b>+{fmt(reward)} FC</b>\n🔥 Streak: <b>{streak}</b>',reply_markup=back_menu(),parse_mode='HTML')
    except Exception as e: await c.answer(str(e)[:180],show_alert=True)

@dp.callback_query(F.data=='refs')
async def refs(c:CallbackQuery):
    u=await get_user(c.from_user.id); rows=await get_referrals(c.from_user.id)
    botname=settings.bot_username or (await bot.get_me()).username
    link=f'https://t.me/{botname}?start=ref_{u["id"]}'
    await c.message.edit_text(f'👥 <b>РЕФЕРАЛЫ</b>\n\nПриглашено: <b>{u["referrals"]}</b>\nНаграда: <b>{settings.ref_reward} FC</b>\n\n<code>{link}</code>',reply_markup=back_menu(),parse_mode='HTML'); await c.answer()

@dp.callback_query(F.data=='rating')
async def rating(c:CallbackQuery):
    rows=await leaderboard(10); text='🏆 <b>ТОП ИГРОКОВ</b>\n\n'
    for i,u in enumerate(rows,1): text+=f'{i}. {html.escape(u["first_name"] or u["username"] or str(u["id"]))} — <b>{fmt(u["balance"])} FC</b>\n'
    await c.message.edit_text(text,reply_markup=back_menu(),parse_mode='HTML'); await c.answer()

@dp.callback_query(F.data=='shop')
async def shop(c:CallbackQuery):
    rows=await get_shop(); text='🛒 <b>МАГАЗИН</b>\n\n'
    for x in rows: text+=f"• <b>{html.escape(x['title'])}</b> — {fmt(x['price'])} FC\n  <code>{x['code']}</code>\n"
    await c.message.edit_text(text,reply_markup=back_menu(),parse_mode='HTML'); await c.answer()

@dp.callback_query(F.data=='pvp')
async def pvp(c:CallbackQuery):
    rows=await get_open_pvp(); text='⚔️ <b>PVP LOBBY</b>\n\n'
    if not rows: text+='Открытых матчей нет.\nИспользуй /pvp 250 dice чтобы создать.'
    else:
        for x in rows[:10]: text+=f"#{x['id']} · {x['game_code']} · {fmt(x['stake'])} FC\n"
    await c.message.edit_text(text,reply_markup=back_menu(),parse_mode='HTML'); await c.answer()

@dp.message(Command('pvp'))
async def pvp_cmd(m:Message):
    parts=(m.text or '').split(); stake=int(parts[1]) if len(parts)>1 and parts[1].isdigit() else 250; code=parts[2] if len(parts)>2 else 'dice'
    try:
        x=await create_pvp(m.from_user.id,stake,code); await m.answer(f'⚔️ Матч #{x["id"]} создан\n🎮 {code}\n💰 Ставка {fmt(stake)} FC\n\nДругой игрок может подключиться через /joinpvp {x["id"]}')
    except Exception as e: await m.answer(f'❌ {e}')

@dp.message(Command('joinpvp'))
async def joinpvp_cmd(m:Message):
    parts=(m.text or '').split()
    if len(parts)<2: await m.answer('Используй /joinpvp ID'); return
    try:
        x=await join_pvp(int(parts[1]),m.from_user.id); await m.answer(f'⚔️ Матч #{x["id"]} начат!\nСоздатель: {x["creator_id"]}\nСоперник: {x["opponent_id"]}\nТеперь матч можно завершить серверным PvP-раундом.')
        try: await bot.send_message(x['creator_id'],f'⚔️ Твой матч #{x["id"]} принят соперником! Используй /finishpvp {x["id"]}')
        except: pass
    except Exception as e: await m.answer(f'❌ {e}')

@dp.message(Command('finishpvp'))
async def finishpvp_cmd(m:Message):
    parts=(m.text or '').split()
    if len(parts)<2: await m.answer('Используй /finishpvp ID'); return
    try:
        match=await __import__('app.db',fromlist=['get_pvp']).get_pvp(int(parts[1]))
        if not match or match['status']!='active': raise ValueError('Матч не активен')
        creator_score=random.randint(1,6); opponent_score=random.randint(1,6)
        winner=match['creator_id'] if creator_score>opponent_score else match['opponent_id']
        loser=match['opponent_id'] if winner==match['creator_id'] else match['creator_id']
        x=await finish_pvp(match['id'],winner,loser,creator_score,opponent_score)
        await m.answer(f'🏁 Матч #{x["id"]}\nСчёт {creator_score}:{opponent_score}\n🏆 Победитель: <code>{winner}</code>\n💰 Приз: {fmt(x["prize"])} FC',parse_mode='HTML')
    except Exception as e: await m.answer(f'❌ {e}')

@dp.message(Command('stats'))
async def stats_cmd(m:Message):
    if not await is_admin(m.from_user.id): await m.answer('❌ Только для админа'); return
    s=await get_stats(); await m.answer(f'📊 USERS {s["users"]}\n🎮 GAMES {s["games"]}\n⚔️ PVP {s["pvp_matches"]}\n👥 REFS {s["referrals"]}\n💰 COINS {fmt(s["total_coins"])}')

@dp.message(Command('give'))
async def give_cmd(m:Message):
    if not await is_admin(m.from_user.id): await m.answer('❌'); return
    p=(m.text or '').split();
    if len(p)<3: await m.answer('/give USER_ID AMOUNT'); return
    try: r=await admin_give(m.from_user.id,int(p[1]),int(p[2]),'admin_give'); await m.answer(f'✅ Выдано. Баланс: {fmt(r)}')
    except Exception as e: await m.answer(f'❌ {e}')

@dp.message(Command('take'))
async def take_cmd(m:Message):
    if not await is_admin(m.from_user.id): await m.answer('❌'); return
    p=(m.text or '').split();
    if len(p)<3: await m.answer('/take USER_ID AMOUNT'); return
    try: r=await admin_take(m.from_user.id,int(p[1]),int(p[2]),'admin_take'); await m.answer(f'✅ Списано. Баланс: {fmt(r)}')
    except Exception as e: await m.answer(f'❌ {e}')

@dp.message(Command('ban'))
async def ban_cmd(m:Message):
    if not await is_admin(m.from_user.id): await m.answer('❌'); return
    p=(m.text or '').split();
    if len(p)<2: await m.answer('/ban USER_ID [on/off]'); return
    val=not(len(p)>2 and p[2].lower()=='off')
    try: await set_ban(m.from_user.id,int(p[1]),val); await m.answer('✅ Готово')
    except Exception as e: await m.answer(f'❌ {e}')

async def start_bot():
    if not settings.bot_token: raise RuntimeError('BOT_TOKEN is not configured')
    await init_db(); log.info('BOT ONLINE')
    try: await dp.start_polling(bot)
    finally: await close_db(); await bot.session.close()

if __name__=='__main__': asyncio.run(start_bot())
